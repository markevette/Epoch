# Live SQLite file for a single-process host. The published host sets its own database.
EPOCH_DB=/var/lib/epoch/epoch.sqlite
# Copies of that file. Prefer a different disk from the live file.
# EPOCH_BACKUP_DIR=/var/lib/epoch/backups

EPOCH_SEED_DEMO=0
EPOCH_ADMIN_EMAIL=you@example.com
EPOCH_ADMIN_PASSWORD=replace-with-8-or-more

# Shared door for this beta. Staff can also mint one-use invites.
# EPOCH_BETA_CODE=

# Mail for password reset. Leave empty and staff send the note from the door page.
# EPOCH_MAIL_KEY=
# EPOCH_MAIL_FROM=

# EPOCH_COOKIE_SECURE=0
# EPOCH_PUBLIC_URL=https://health.example.com

# EPOCH_LEGAL_NAME=
# EPOCH_LEGAL_STREET=
# EPOCH_LEGAL_POSTAL=
# EPOCH_LEGAL_CITY=
# EPOCH_LEGAL_COUNTRY=Germany
# EPOCH_LEGAL_EMAIL=
